<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="song"
            type="com.example.romajijp.model.Song" />
        <variable
            name="isJP"
            type="Boolean" />
        <variable
            name="isLoading"
            type="Boolean" />
        <variable
            name="isSaved"
            type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#2D0B1C"
        tools:context=".activity.LyricsDisplay">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2D0B1C"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Lyrics"
                app:titleTextColor="#FDE6D2"
                app:navigationIconTint="#FDE6D2"
                app:navigationIcon="?attr/homeAsUpIndicator" />

        </com.google.android.material.appbar.AppBarLayout>

        <ProgressBar
            android:id="@+id/loadingProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#FDE6D2"
            android:visibility="@{isLoading ? android.view.View.VISIBLE : android.view.View.GONE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/appBarLayout" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:visibility="@{isLoading ? android.view.View.GONE : android.view.View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/appBarLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/albumCoverCard"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:strokeColor="#FDE6D2"
                    app:strokeWidth="2dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivAlbumCover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:imageUrl="@{song.artworkUrl}"
                        tools:ignore="ContentDescription"
                        tools:src="@tools:sample/backgrounds/scenic" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/songTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@{song.title}"
                    android:textAppearance="?attr/textAppearanceHeadlineMedium"
                    android:textColor="#FDE6D2"
                    android:textStyle="bold"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/albumCoverCard"
                    tools:text="Song Title" />

                <TextView
                    android:id="@+id/songArtist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@{song.artist}"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="#C0A0B0"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/songTitle"
                    tools:text="Artist Name" />

                <TextView
                    android:id="@+id/songAlbum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@{song.album}"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="#A08090"
                    android:gravity="center"
                    android:visibility="@{song.album != null ? android.view.View.VISIBLE : android.view.View.GONE}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/songArtist"
                    tools:text="Album Name" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Download Song"
                    android:textColor="#2D0B1C"
                    android:visibility="@{isSaved ? android.view.View.GONE : android.view.View.VISIBLE}"
                    app:backgroundTint="#FDE6D2"
                    app:cornerRadius="24dp"
                    app:icon="@android:drawable/stat_sys_download"
                    app:iconTint="#2D0B1C"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/songAlbum" />

                <com.google.android.material.divider.MaterialDivider
                    android:id="@+id/divider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:dividerColor="#3D1528"
                    app:layout_constraintTop_toBottomOf="@id/btnDownload" />

                <LinearLayout
                    android:id="@+id/lyricsSelectionContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:visibility="@{isJP ? android.view.View.VISIBLE : android.view.View.GONE}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOriginalLyrics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="Original"
                        android:textColor="#2D0B1C"
                        app:backgroundTint="#FDE6D2"
                        app:cornerRadius="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRomanizedLyrics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Romaji"
                        android:textColor="#FDE6D2"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        app:strokeColor="#FDE6D2"
                        app:cornerRadius="20dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/lyricsText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:lineSpacingExtra="8dp"
                    android:text='@{song.lyrics ?? "No lyrics found for this song."}'
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="#FDE6D2"
                    android:textSize="18sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lyricsSelectionContainer"
                    tools:text="Lyrics will appear here...\nLine 2\nLine 3" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
